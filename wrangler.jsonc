{
  "name": "publicservice",
  "keep_vars": true,
  "compatibility_date": "2024-09-23",
  "main": "src/index.js",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // ใช้ฐานข้อมูลเดียวกับ banpadeng-school-db และ students-report
  "d1_databases": [
    { "binding": "DB", "database_name": "banpadeng_school_db", "database_id": "870fa9ec-122f-4161-a1ca-cc9979dcfa30" }
  ],
  "routes": [
    { "pattern": "publicservice.banpadengschool.ac.th", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
